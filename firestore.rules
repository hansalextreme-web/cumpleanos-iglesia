rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────

    function esAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admin/$(request.auth.token.email));
    }

    // ── Reglas por colección ─────────────────────────────────────

    // Miembros: cualquier autenticado puede leer (query por correo permitida)
    match /miembros/{docId} {
      allow read:  if request.auth != null;
      allow write: if esAdmin();
    }

    // Lectores: cada usuario lee su propio doc; admin lista toda la colección
    match /lectores/{email} {
      allow read:  if esAdmin()
                  || (request.auth != null && request.auth.token.email == email);
      allow write: if esAdmin();
    }

    // Usuarios: cada usuario lee/escribe su propio doc; admin lee todos
    match /usuarios/{uid} {
      allow read:  if esAdmin()
                  || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Admin: cada usuario lee su propio doc; admin lista toda la colección
    match /admin/{email} {
      allow read:  if esAdmin()
                  || (request.auth != null && request.auth.token.email == email);
      allow write: if esAdmin();
    }

  }
}
