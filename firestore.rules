rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección de miembros: lectura pública, escritura solo para admins autenticados
    match /miembros/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
                      exists(/databases/$(database)/documents/admind/$(request.auth.token.email));
    }

    // Colección de admins: lectura para usuarios autenticados, escritura solo para admins existentes
    match /admind/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      exists(/databases/$(database)/documents/admind/$(request.auth.token.email));
    }
  }
}
