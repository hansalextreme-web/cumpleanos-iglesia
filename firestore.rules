rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────
    // El ID del documento en admin, lectores y miembros ES el email
    // (minúsculas), igual que request.auth.token.email.

    function esAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/admin/$(request.auth.token.email));
    }

    function esMiembro() {
      return request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/miembros/$(request.auth.token.email));
    }

    function esLector() {
      return request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/lectores/$(request.auth.token.email));
    }

    function tieneAcceso() {
      return esAdmin() || esMiembro() || esLector();
    }

    // ─── miembros/{email} ────────────────────────────────────────
    // tieneAcceso() → puede leer toda la colección (admin/lector/miembro)
    // Cualquier autenticado puede leer su PROPIO documento por ID para
    // que verificarAcceso() compruebe membresía sin permission-denied.
    match /miembros/{email} {
      allow read:  if tieneAcceso()
                  || (request.auth != null
                      && request.auth.token.email == email);
      allow write: if esAdmin();
    }

    // ─── lectores/{email} ────────────────────────────────────────
    // Cualquier autenticado puede leer su PROPIO documento.
    match /lectores/{email} {
      allow read:  if esAdmin()
                  || (request.auth != null
                      && request.auth.token.email == email);
      allow write: if esAdmin();
    }

    // ─── admin/{email} ───────────────────────────────────────────
    // Cualquier autenticado puede leer su PROPIO documento.
    // Solo un admin existente puede escribir (impide auto-promoción).
    match /admin/{email} {
      allow read:  if esAdmin()
                  || (request.auth != null
                      && request.auth.token.email == email);
      allow write: if esAdmin();
    }

    // ─── usuarios/{uid} ──────────────────────────────────────────
    match /usuarios/{uid} {
      allow read:  if esAdmin()
                  || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
