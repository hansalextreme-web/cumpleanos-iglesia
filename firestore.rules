rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────

    function esAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admin/$(request.auth.token.email));
    }

    // ── Reglas por colección ─────────────────────────────────────

    // Miembros del directorio: cualquier usuario autenticado puede leer
    // (la verificación de acceso real se hace en el cliente con query por correo)
    match /miembros/{docId} {
      allow read:  if request.auth != null;
      allow write: if esAdmin();
    }

    // Lectores: cada usuario lee solo su propio documento
    match /lectores/{email} {
      allow read:  if request.auth != null && request.auth.token.email == email;
      allow write: if esAdmin();
    }

    // Usuarios: perfil propio; admin lee todos
    match /usuarios/{uid} {
      allow read:  if esAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Admin: cada usuario lee solo su propio documento
    match /admin/{email} {
      allow read:  if request.auth != null && request.auth.token.email == email;
      allow write: if esAdmin();
    }

  }
}
