rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────
    // El ID del documento en admin, lectores y miembros ES el email
    // (minúsculas), igual que request.auth.token.email.

    function esAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/admin/$(request.auth.token.email));
    }

    function esMiembro() {
      return request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/miembros/$(request.auth.token.email));
    }

    function esLector() {
      return request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/lectores/$(request.auth.token.email));
    }

    function tieneAcceso() {
      return esAdmin() || esMiembro() || esLector();
    }

    // ─── miembros/{email} ────────────────────────────────────────
    // Solo quien ya tiene acceso (admin/lector/miembro) puede leer.
    // Solo admin puede escribir.
    match /miembros/{docId} {
      allow read:  if tieneAcceso();
      allow write: if esAdmin();
    }

    // ─── lectores/{email} ────────────────────────────────────────
    // IMPORTANTE: cualquier usuario autenticado puede leer su PROPIO documento.
    // Esto es necesario para que verificarAcceso() en el cliente pueda
    // comprobar si el usuario es lector SIN causar permission-denied.
    match /lectores/{email} {
      allow read:  if request.auth != null
                  && (esAdmin() || request.auth.token.email == email);
      allow write: if esAdmin();
    }

    // ─── admin/{email} ───────────────────────────────────────────
    // IMPORTANTE: cualquier usuario autenticado puede leer su PROPIO documento.
    // Esto es necesario para que verificarAcceso() pueda comprobar si el
    // usuario es admin SIN causar permission-denied.
    // Solo un admin existente puede escribir (impide auto-promoción).
    match /admin/{email} {
      allow read:  if request.auth != null
                  && (esAdmin() || request.auth.token.email == email);
      allow write: if esAdmin();
    }

    // ─── usuarios/{uid} ──────────────────────────────────────────
    // Cada usuario lee y escribe solo su propio perfil.
    // Admin puede leer todos.
    match /usuarios/{uid} {
      allow read:  if esAdmin()
                  || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
